---
import Layout from '../layouts/Layout.astro';
import Bookshelf from '../components/Bookshelf.jsx';
---

<Layout>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Page Header -->
    <div class="mb-4 md:mb-8 pt-6 md:pt-8 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-light text-monk-900 mb-4 tracking-wide text-wabi">
        Interactive Readings
      </h1>
      <div class="h-px w-16 bg-monk-300 mx-auto mb-6"></div>
      <p class="text-base sm:text-lg text-monk-800 font-light">
        A quiet collection of digital books containing timeless wisdom and reflections. Choose a book from the shelf to begin.
      </p>
    </div>

    <!-- Bookshelf Container -->
    <div class="w-full flex justify-center pb-12">
      <!-- client:only="react" ensures the component renders only on the client side since it uses React hooks -->
      <Bookshelf client:only="react" />
    </div>
  </div>
</Layout>
