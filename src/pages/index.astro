---
import Layout from '../layouts/Layout.astro';
import DhammapadaQuote from '../components/DhammapadaQuote.astro';
import postsData from '../data/posts.json';

// Sort posts by date (newest first)
const allPosts = [...postsData].sort((a, b) => 
  new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);
---
<Layout>
  <DhammapadaQuote />
  <!-- Background Video -->
  <div class="fixed top-0 left-0 w-full h-screen -z-10 overflow-hidden bg-monk-200">
    <video 
      id="bg-video"
      autoplay 
      loop 
      muted 
      playsinline
      preload="auto"
      poster="/logo.png"
      class="min-w-full min-h-full w-auto h-auto absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 object-cover opacity-50 mix-blend-multiply"
      aria-hidden="true"
    >
      <source src="/video/background.mp4" type="video/mp4">
    </video>
    <!-- Shoji Screen/Rice Paper effect overlay but with a soft green tint -->
    <div class="absolute inset-0 bg-monk-100/90 backdrop-blur-3xl"></div>
    <div class="absolute inset-0 bg-monk-900/5 mix-blend-overlay"></div>
    <div class="absolute inset-0 bg-grain mix-blend-multiply opacity-60"></div>
  </div>

  <!-- Hero Section -->
  <div class="mb-10 md:mb-16 pt-4 md:pt-8 pb-8 md:pb-12 relative w-full flex justify-start">
    <div class="space-y-5 md:space-y-8 max-w-3xl px-4 sm:px-8 lg:px-12 w-full ml-0 lg:ml-8 xl:ml-16">
      
      <div class="pl-4 sm:pl-5 border-l-2 w-full max-w-2xl border-monk-800/20">
        <h1 class="text-4xl sm:text-5xl md:text-[4rem] font-display font-medium mb-4 leading-[1.1] tracking-wide text-monk-900 text-wabi">
          Kalyanamitta
        </h1>
        
        <p class="text-base sm:text-lg md:text-xl text-monk-800 leading-relaxed max-w-lg tracking-wide font-light mt-4">
          A collection of teachings, reflections, and insights on the path to enlightenment.
        </p>
      </div>
      
      <div class="flex flex-wrap justify-start gap-4 md:gap-8 pt-4 pl-4 sm:pl-6">
        <a href="/writings" class="group relative px-6 md:px-8 py-3 bg-monk-900 hover:bg-monk-800 text-monk-50 rounded-full font-light tracking-widest transition-all duration-300 text-sm overflow-hidden blur-[0.3px] hover:blur-none border border-monk-900 shadow-sm hover:shadow-md">
          <span class="relative z-10 flex items-center gap-3">
            Explore Writings
            <span class="w-8 h-px bg-monk-50 group-hover:translate-x-2 transition-transform duration-500"></span>
          </span>
        </a>
        <a href="/connect" class="group relative px-6 md:px-8 py-3 bg-transparent hover:bg-monk-900/10 text-monk-800 rounded-full font-light tracking-widest transition-all duration-300 text-sm border border-monk-800/30 hover:border-monk-800">
          <span class="relative z-10 flex items-center gap-2">
            Connect
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Writings Section -->
  <div class="mb-16 md:mb-24">
    <div class="flex items-center justify-between mb-10 px-4 sm:px-8 lg:px-12 w-full lg:ml-8 xl:ml-16 max-w-6xl">
      <div class="flex items-center gap-6 md:gap-8 flex-1">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-light text-monk-900 whitespace-nowrap tracking-wide">
          Writings
        </h2>
        <div class="flex-1 h-px bg-monk-900/15"></div>
      </div>
      <a href="/writings" class="text-monk-700 font-light tracking-wide hover:text-monk-900 flex items-center gap-2 text-sm md:text-base whitespace-nowrap ml-8 transition-colors duration-300 group">
        View All
        <span class="w-4 h-px bg-monk-700 group-hover:bg-monk-900 transition-colors duration-300"></span>
      </a>
    </div>
    
    <!-- Continuous Train Carousel -->
    <div class="relative overflow-hidden mb-12 py-4">
      <div class="flex gap-6 md:gap-10 px-4 sm:px-8 lg:px-12 ml-0 lg:ml-8 xl:ml-16 items-stretch" id="carousel">
        {(allPosts.length > 1 ? allPosts.concat(allPosts) : allPosts).map((post, index) => (
          <div class="min-w-[calc(100vw-3rem)] sm:min-w-[320px] md:min-w-[420px] flex flex-shrink-0">
              <a 
                href={post.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group w-full flex flex-col p-6 sm:p-8 transition-all duration-700 relative bg-monk-50/80 hover:bg-[#FFFFFF] backdrop-blur-sm rounded-[2rem] outline-none border border-monk-800/10 hover:border-monk-800/20 shadow-[0_8px_30px_rgb(0,0,0,0.02)] hover:shadow-[0_8px_40px_rgb(0,0,0,0.06)]"
              >
                <div class="flex flex-col h-full space-y-6">
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-3">
                      {post.pubDate && (
                        <>
                          <div class="inline-flex items-center text-xs font-light tracking-widest text-monk-700 uppercase">
                            {new Date(post.pubDate).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })}
                          </div>
                          <div class="w-1 h-1 rounded-full bg-monk-700"></div>
                        </>
                      )}
                      {post.languages && post.languages.map((lang: string) => (
                        <span class="text-xs font-light tracking-widest text-monk-800/60 uppercase">
                          {lang}
                        </span>
                      ))}
                    </div>
                  </div>
                  
                  <h3 class="text-xl md:text-2xl font-display font-light text-monk-900 group-hover:text-monk-800 transition-colors line-clamp-2 leading-snug tracking-wide text-wabi">
                    {post.title}
                  </h3>
                  
                  <p class="text-sm md:text-base font-light text-monk-800/80 leading-relaxed line-clamp-3 md:line-clamp-4">
                    {post.description}
                  </p>
                  
                  <div class="flex-grow"></div>
                  
                  <div class="flex items-center gap-3 text-monk-700 group-hover:text-monk-900 transition-colors duration-500 font-light tracking-widest pt-4 mt-auto border-t border-monk-900/10 w-full">
                    <span class="text-xs uppercase mt-4">Read</span>
                    <span class="w-8 h-[1px] bg-monk-900/20 group-hover:bg-monk-900/50 transition-colors duration-500 mt-4"></span>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Pause on Hover Indicator -->
      <div class="flex justify-center gap-2 mt-4 md:mt-6 px-4">
        <p class="text-xs sm:text-sm text-monk-700">Hover to pause</p>
      </div>
    </div>
  </div>

  <script>
    function initHomePage() {
      // Reset and play background video
      const bgVideo = document.getElementById('bg-video') as HTMLVideoElement | null;
      if (bgVideo) {
        bgVideo.currentTime = 0;
        bgVideo.play().catch(() => {
          // Autoplay might be blocked, try muted
          bgVideo.muted = true;
          bgVideo.play();
        });
      }

      // Initialize carousel
      const carousel = document.getElementById('carousel') as HTMLElement | null;
      if (!carousel) return;

      const itemCount = carousel.children.length;
      
      // Only animate if there are duplicated items (more than 1 unique post)
      if (itemCount <= 1) return;

      let scrollPosition = 0;
      let animationId: number;
      let isPaused = false;
      const speed = 0.5;

      function animate() {
        if (!isPaused && carousel) {
          scrollPosition += speed;
          const maxScroll = carousel.scrollWidth / 2;
          
          if (scrollPosition >= maxScroll) {
            scrollPosition = 0;
          }
          
          carousel.style.transform = `translateX(-${scrollPosition}px)`;
        }
        animationId = requestAnimationFrame(animate);
      }

      carousel.addEventListener('mouseenter', () => {
        isPaused = true;
      });

      carousel.addEventListener('mouseleave', () => {
        isPaused = false;
      });

      animate();
    }

    // Run on initial load
    document.addEventListener('DOMContentLoaded', initHomePage);
    // Run on navigation (Astro View Transitions)
    document.addEventListener('astro:page-load', initHomePage);
  </script>

</Layout>